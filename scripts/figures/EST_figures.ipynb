   "source": [
    "# --- global inputs ---\n",
    "#locations of sites, lon/lat (°)\n",
    "bronx = [-73.8782,40.8680]\n",
    "nbrunswick = [-74.4226,40.4728]\n",
    "underhill = [-72.8684,44.5283]\n",
    "huntington = [-74.2231,43.9731]"
   ]
  },
