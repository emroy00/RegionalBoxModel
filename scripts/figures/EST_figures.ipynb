   "source": [
    "# --- user inputs ---\n",
    "year = 2017\n",
    "option = 'mean'  #optimization strategy\n",
    "shift = -5 #shifting to EST from UTC\n",
    "roll = 5\n",
    "wthresh = 25\n",
    "figformat = 'pdf'\n",
    "dpi=500\n",
    "\n",
    "# select figures to plot\n",
    "figure1   = True \n",
    "figure2_5 = True #You get fig 5 for free with fig 2\n",
    "figure3   = True\n",
    "figure4   = True\n",
    "\n",
    "figpath = '../../results/'\n",
    "path = '../../data/GCdata/'\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "85f566fe-384a-43fb-9ffc-e0f4b2151082",
   "metadata": {},
